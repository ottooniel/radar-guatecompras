{
  "name": "radar-guatecompras",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "etl": "tsx packages/etl/src/cli.ts",
    "migrate": "tsx packages/etl/src/cli-migrar.ts",
    "load": "tsx packages/etl/src/cli-cargar.ts",
    "r2": "tsx packages/etl/src/cli-r2.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/**\" --filter \"./apps/**\" typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @radar-guatecompras/web build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
