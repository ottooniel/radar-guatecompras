# Local: docker compose. En GitHub Actions, la cadena del Session pooler (puerto 5432),
# terminada en ?sslmode=no-verify. La web en Vercel usa el Transaction pooler (6543):
# ver apps/web/.env.example.
# Postgres conserva 5 meses por el límite de 500 MB del plan gratis de Supabase.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
