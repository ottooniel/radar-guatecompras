# Next.js lee apps/web/.env.local. No usa el .env de la raíz.
# Local: la cadena de docker compose, puerto 5432.
# En Vercel: Transaction pooler de Supabase, puerto 6543,
# usuario postgres.<proyecto>, terminada en ?sslmode=no-verify.
# El ETL de GitHub Actions sigue con el Session pooler (5432).
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
